# AI Software Factory Studio — isolated configuration (copy to .env)
# Bind address. Keep 127.0.0.1 unless you need remote access.
ASF_HOST=127.0.0.1
ASF_PORT=4317
# Required when ASF_HOST is not a loopback address.
ASF_AUTH_TOKEN=
# Extra origins allowed to call mutating endpoints (comma-separated).
ASF_ALLOWED_ORIGINS=
# Data directory (SQLite DB, workspaces, worktrees). Relative to the app root.
ASF_DATA_DIR=./data
# Folders the studio may import repositories from (semicolon-separated absolute paths).
ASF_APPROVED_ROOTS=
# OpenAI-compatible provider (optional). The key is read from the env var named below.
ASF_OPENAI_BASE_URL=
ASF_OPENAI_API_KEY=
